---
import ThemeToggle from '../ui/ThemeToggle.astro';

const navLinks = [
  { label: 'About', href: '/portfolio-a3/' },
  { label: 'Experience', href: '/portfolio-a3/experience' },
  { label: 'Projects', href: '/portfolio-a3/projects' },
  { label: 'Contact', href: '/portfolio-a3/contact' },
];

const currentPath = Astro.url.pathname;
---

<header>
  <nav aria-label="Main navigation">
    <a href="/portfolio-a3/" class="site-name" aria-label="Ashukla Portfolio home">
      Ashukla
    </a>

    <ul role="list">
      {navLinks.map(({ label, href }) => (
        <li>
          
            href={href}
            aria-current={currentPath === href ? 'page' : undefined}
            class="nav-link"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <ThemeToggle />
  </nav>
</header>

<style>
  header {
    border-bottom: 1px solid rgb(var(--color-border));
    padding: 1rem;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: 64rem;
    margin: 0 auto;
  }

  .site-name {
    font-weight: 700;
    color: rgb(var(--color-text));
    text-decoration: none;
    margin-right: auto;
  }

  ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: rgb(var(--color-text-muted));
    text-decoration: none;
    font-size: 0.95rem;
  }

  .nav-link[aria-current="page"] {
    color: rgb(var(--color-text));
    font-weight: 600;
  }
</style>