---
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <span class="copyright">© {currentYear} Ashukla</span>
    <nav aria-label="Footer navigation">
      <a href="/portfolio-a3/contact" class="contact-link">Contact</a>
    </nav>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid rgb(var(--color-border));
    padding: 1.5rem 1rem;
    margin-top: auto;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 64rem;
    margin: 0 auto;
    font-size: 0.875rem;
    color: rgb(var(--color-text-muted));
  }

  .contact-link {
    color: rgb(var(--color-text-muted));
    text-decoration: none;
  }

  .contact-link:hover {
    color: rgb(var(--color-text));
  }
</style>